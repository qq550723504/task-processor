# The existing pinned Go SDK installs its matching driver and browser at build
# time. The serving container never downloads or installs browser dependencies.
FROM ubuntu:24.04 AS data-services-runtime
ENV DEBIAN_FRONTEND=noninteractive PLAYWRIGHT_DRIVER_PATH=/opt/data-services/playwright PLAYWRIGHT_BROWSERS_PATH=/opt/data-services/browsers
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata wget && rm -rf /var/lib/apt/lists/*
COPY --from=go-builder /out/playwright-install /usr/local/bin/playwright-install
RUN playwright-install install --with-deps chromium && \
    browser="$(find /opt/data-services/browsers -type f -name chrome)" && \
    test -n "$browser" && test "$(printf '%s\n' "$browser" | wc -l)" -eq 1 && \
    ln -s "$browser" /opt/data-services/chromium && \
    rm /usr/local/bin/playwright-install && rm -rf /var/lib/apt/lists/*
COPY --from=go-builder /out/current-application /usr/local/bin/current-application
ENTRYPOINT ["/usr/local/bin/current-application"]
