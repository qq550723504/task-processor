# Official pinned release binaries remain available while pinned registry images
# cannot be pulled. Verify their published SHA256; do not use a third-party mirror.
FROM alpine:3.22 AS server
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.version="RELEASE.2025-04-22T22-12-26Z" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
RUN case "$(uname -m)" in \
      x86_64) arch=amd64; digest=53e2a2cb16c5366ea6fbbc479c19ddb4c6a0948273e752f740fb1fbf27bb817c ;; \
      aarch64) arch=arm64; digest=6c2f3142c94240206123177f4ba1e360daa5d1e0a4962e90757ef4f92c3ab57c ;; \
      *) exit 1 ;; \
    esac \
    && wget -q -O /usr/local/bin/minio "https://github.com/minio/minio/releases/download/RELEASE.2025-04-22T22-12-26Z/minio.linux-${arch}.RELEASE.2025-04-22T22-12-26Z" \
    && printf '%s  /usr/local/bin/minio\n' "$digest" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/minio
ENTRYPOINT ["minio"]

FROM alpine:3.22 AS client
LABEL org.opencontainers.image.source="https://github.com/minio/mc" \
      org.opencontainers.image.version="RELEASE.2025-04-16T18-13-26Z" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
RUN case "$(uname -m)" in \
      x86_64) arch=amd64; digest=ac90da87a35641be5a0ac75d49de5161ddb47d629b5ba01261b0ae9e00aea15f ;; \
      aarch64) arch=arm64; digest=61bb88e7435919834478ddd4d405a6de6d2c227079da5e8ee9655147398819a0 ;; \
      *) exit 1 ;; \
    esac \
    && wget -q -O /usr/local/bin/mc "https://github.com/minio/mc/releases/download/RELEASE.2025-04-16T18-13-26Z/mc.linux-${arch}.RELEASE.2025-04-16T18-13-26Z" \
    && printf '%s  /usr/local/bin/mc\n' "$digest" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/mc
ENTRYPOINT ["mc"]
